        <item>
            <title>0.1.3</title>
            <pubDate>Sat, 22 Aug 2026 16:51:22 +0800</pubDate>
            <link>https://github.com/patrick-fu/agent-metrics-macos/releases/tag/v0.1.3</link>
            <sparkle:version>4</sparkle:version>
            <sparkle:shortVersionString>0.1.3</sparkle:shortVersionString>
            <sparkle:minimumSystemVersion>14.0</sparkle:minimumSystemVersion>
            <sparkle:hardwareRequirements>arm64</sparkle:hardwareRequirements>
            <description sparkle:format="markdown"><![CDATA[This patch keeps the menu bar panel anchored below the status item while live metric updates change its content height.

- Preserve the panel top edge across repeated growth and shrink cycles.
- Clamp dynamic panel sizes to the active screen visible area.
- Add an AppKit regression test for delayed snapshot resizing.
]]></description>
            <enclosure url="https://github.com/patrick-fu/agent-metrics-macos/releases/download/v0.1.3/CodingAgentMetrics-0.1.3.dmg" length="2574280" type="application/octet-stream" sparkle:edSignature="prseBNybwNu4pcTktuUfSar4iJpZ6eXaXPluQIuWH3n4hocQxEpnyRguROoLssEtZ5DBbipFAlSFHEhc1u07BQ=="/>
        </item>
        <item>
            <title>0.1.2</title>
            <pubDate>Sat, 22 Aug 2026 16:17:00 +0800</pubDate>
            <link>https://github.com/patrick-fu/agent-metrics-macos/releases/tag/v0.1.2</link>
            <sparkle:version>3</sparkle:version>
            <sparkle:shortVersionString>0.1.2</sparkle:shortVersionString>
            <sparkle:minimumSystemVersion>14.0</sparkle:minimumSystemVersion>
            <sparkle:hardwareRequirements>arm64</sparkle:hardwareRequirements>
            <description sparkle:format="markdown"><![CDATA[Coding Agent Metrics 0.1.2 keeps metrics available when local Codex or Claude Code histories exceed the active discovery window. It also prevents confirmation surfaces from re-entering menu bar panel dismissal.

- Large histories now retain a bounded recent window and report partial coverage instead of making the source unavailable.
- Confirmation, modal, and menu interactions no longer trigger recursive panel dismissal.
- Local metadata-only collection and privacy boundaries are unchanged.
]]></description>
            <enclosure url="https://github.com/patrick-fu/agent-metrics-macos/releases/download/v0.1.2/CodingAgentMetrics-0.1.2.dmg" length="2570888" type="application/octet-stream" sparkle:edSignature="od7Rtu/O/Cz4QQsgoAU8vMgGH8pshQWLmuvnZnTlIwCX9JSA5M8yjbfc8K73t7868bUBK0rJMgnrnNcS5AtmAg=="/>
        </item>
